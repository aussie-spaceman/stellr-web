# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=<your_project_id>
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=<write_token_for_mutations>

# Site
NEXT_PUBLIC_SITE_URL=https://www.stellreducation.org

# Media host (rollout videos/photos/PDFs). Leave EMPTY to self-host from
# /public on Vercel (default). To move bytes off Vercel later: upload
# /public/{videos,media,files} to a Supabase public bucket or Cloudflare R2
# (preserving those paths), then set this to the bucket/CDN root — the manifest
# and gated-download emails repoint automatically, no code changes.
#   e.g. https://media.stellreducation.org   (no trailing slash)
NEXT_PUBLIC_MEDIA_BASE_URL=

# Analytics — Google Tag Manager ONLY. GA4 and every event/measurement tag are
# configured inside the GTM UI, not in code. Do NOT add advertising, remarketing,
# or cross-site tracking tags (Meta Pixel, LinkedIn Insight, Google Ads/Signals) —
# the privacy policy forbids them. Same container ID on www + app so sessions
# persist across subdomains.
NEXT_PUBLIC_GTM_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://hwtzpfrnksksxlwwabqz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key_from_supabase_dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_from_supabase_dashboard>

# Clerk Auth — get these from clerk.com dashboard after creating an application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account/onboarding

# Stripe
STRIPE_SECRET_KEY=<stripe_secret_key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe_publishable_key>
NEXT_PUBLIC_DONATION_URL=

# Email (Resend — FREE plan: 1 verified domain, 3,000/month, 100/day)
# mail.stellreducation.org is the ONLY verified domain. Every *_FROM below must
# stay on it; a send from any other domain is rejected by Resend. Reply-To and
# recipient addresses need no verification, so they use the apex freely.
RESEND_API_KEY=<your_resend_api_key>
# Where public form submissions (contact, scholarship, host-event, join-network)
# are delivered. A recipient, not a sender.
CONTACT_EMAIL=david.shaw@stellreducation.org
# Transactional sender — must be on the verified domain, never a personal
# mailbox (Gmail labels self-From mail as SENT, causing phantom duplicates).
TRANSACTIONAL_FROM=Stellr Education <no-reply@mail.stellreducation.org>
# Where member replies to transactional emails are delivered. Also the default
# ICS calendar organizer and the coaching-team fallback, so it must be a real
# monitored mailbox.
TRANSACTIONAL_REPLY_TO=hello@stellreducation.org
# Marketing/campaign sender. Must share the verified domain with
# TRANSACTIONAL_FROM — the Free plan has no second domain to split it onto.
MARKETING_FROM=Stellr Education <hello@mail.stellreducation.org>
# Optional: overrides TRANSACTIONAL_REPLY_TO for coaching-request notifications.
COACHING_TEAM_EMAIL=

# HubSpot — source of truth for every public lead route.
# Prefer a Service Key (Settings → Integrations → Service Keys); HubSpot now
# steers single-account integrations there rather than to legacy private apps.
# Both send the same `Authorization: Bearer` header, so either works here.
# Scopes (four): crm.objects.contacts.read, crm.objects.contacts.write,
# crm.schemas.contacts.write, forms
# Note creation is authorised by crm.objects.contacts.write — there is no
# separate notes scope to grant.
HUBSPOT_ACCESS_TOKEN=<your_hubspot_service_key>
HUBSPOT_PORTAL_ID=24379847
# Loads the HubSpot tracking script, which sets the hubspotutk cookie the lead
# routes pass to the Forms API. Without it every lead attributes to "Offline
# Sources". Leave unset locally to keep test traffic out of the portal.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=24379847
# Form GUIDs, one per lead route — created by `npx tsx scripts/hubspot-setup.ts`,
# which prints them ready to paste. Only form submissions populate Recent
# Conversion / Recent Conversion Date and put an entry on the record timeline;
# without a GUID the route falls back to a plain property write, so the lead is
# captured but stays invisible in the contacts index.
HUBSPOT_FORM_EVENT_NOTIFY=
HUBSPOT_FORM_NEWSLETTER=
HUBSPOT_FORM_WHITE_PAPER=
HUBSPOT_FORM_ASSET_REQUEST=
HUBSPOT_FORM_SCHOLARSHIP=
HUBSPOT_FORM_HOST_EVENT=
HUBSPOT_FORM_TEACHER_GRANT=
# Shared form for every /lp/[slug] audience page. lp_audience and lp_source_page
# distinguish them, so new audience pages need no new form or env var.
HUBSPOT_FORM_LANDING_PAGE=

# ── Audience landing pages ───────────────────────────────────────────────────
# The Motion calendar the lead form hands off to. An env var because it is a
# link on someone else's product and will change without a deploy being welcome.
NEXT_PUBLIC_BOOKING_URL=https://app.usemotion.com/meet/david-m-shaw/welcome
# Shared secret for app/api/webhooks/motion — the route refuses to write without
# it, so an unsigned POST can never stamp "call booked" on a contact.
MOTION_WEBHOOK_SECRET=

# Shared secret for the Apollo engagement webhook (app/api/webhooks/apollo).
# Set on two Apollo workflows — Workflows → trigger "Email clicked" / "Email
# replied" → action "Send webhook" — each POSTing to ?event=clicked or
# ?event=replied and sending this as the header x-apollo-webhook-secret.
# Requires HUBSPOT_ACCESS_TOKEN to also carry crm.objects.deals.read/write.
APOLLO_WEBHOOK_SECRET=

# Apollo API key for the one-off historical backfill (scripts/probe-apollo-
# engagement.ts, scripts/backfill-apollo-engagement.ts). Needs the
# emailer_messages_search endpoint enabled, or a Master key. Local-only — the
# running app never reads it, so it does NOT belong in Vercel.
APOLLO_API_KEY=

# Booking reconciliation (app/api/cron/motion-bookings). Motion has no webhooks
# and no booking API, so the only trace a booking leaves is the event it writes
# onto Google Calendar — this is the calendar to read.
#
# Access: share this calendar with GOOGLE_SERVICE_ACCOUNT_EMAIL as "See all
# event details". That needs no Workspace admin console. Alternatively set
# GOOGLE_CALENDAR_IMPERSONATE to a mailbox, which instead requires
# calendar.readonly to be authorised for the service account's client ID.
MOTION_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATE=
# Substring matched against event titles, case-insensitive. Defaults to
# "Stellr". The calendar holds the whole working day, so without this a dentist
# appointment would stamp "booked an intro call" on whoever was on it.
MOTION_BOOKING_TITLE=
# Extra comma-separated addresses that are Stellr rather than a visitor. The
# organiser, MOTION_CALENDAR_ID and CONTACT_EMAIL are excluded automatically.
MOTION_BOOKING_EXCLUDE_EMAILS=

# Google Sheets (for group registration spreadsheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Places API (New) — school-address autofill on the registration form.
# Server-side only (NOT NEXT_PUBLIC_). Enable "Places API (New)" on the same
# GCP project as the service account above, then restrict the key to that API.
# Leave blank to disable autofill (the picker falls back to manual entry).
GOOGLE_PLACES_API_KEY=

# DocuSign — see https://developers.docusign.com/platform/auth/jwt-formula/
# Use account-d.docusign.com / demo.docusign.net for sandbox; account.docusign.com / your base path for production
DOCUSIGN_OAUTH_URL=https://account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
# Full RSA private key PEM — use literal \n for newlines when stored as a single-line env var
DOCUSIGN_PRIVATE_KEY=
# Optional: pre-built consent form template ID from DocuSign admin (minor / guardian consent)
DOCUSIGN_TEMPLATE_ID=
# Adult & Mentor participation agreement template IDs (carry TeacherPhone / MentorPhone tabs)
DOCUSIGN_ADULT_TEMPLATE_ID=
DOCUSIGN_MENTOR_TEMPLATE_ID=
# Counter-signer added to the Mentor agreement (parallel signer). The template
# must define a 'StellrRepresentative' role at routing order 1. If unset, no
# counter-signer is added.
# NOTE: this is a real signer, not a From address — a person must open the
# DocuSign envelope and sign it, or mentor agreements sit unsigned. Must be on
# stellreducation.org (a `.com` typo here previously routed to a dead mailbox).
DOCUSIGN_STELLR_REP_NAME=Stellr Education
DOCUSIGN_STELLR_REP_EMAIL=hello@stellreducation.org
# HMAC key set in DocuSign Connect configuration for webhook signature verification
DOCUSIGN_CONNECT_HMAC_KEY=

# Vercel Cron — generate a random secret and set it in both .env.local and Vercel project settings
CRON_SECRET=

# Signs the one-click unsubscribe links in event-waitlist mail
# (scripts/notify-event-waitlist.ts). The token is derived from the recipient's
# address rather than stored, because waitlist contacts live only in HubSpot and
# have no member row to hold one. Falls back to CRON_SECRET when unset; changing
# either value invalidates unsubscribe links already sent, so prefer setting
# this one explicitly and leaving it alone.
MARKETING_OPTOUT_SECRET=

# Video conferencing — JaaS (8x8 Jitsi-as-a-Service). Powers in-portal video for
# Coaching/Mentoring sessions and live training lessons (lib/video-provider.ts).
# Get these from the JaaS console at https://jaas.8x8.vc → API Keys.
# Leave blank in dev: calls fall back to open meet.jit.si rooms with NO token.
#   VIDEO_PROVIDER       leave unset (default 'jaas'); set to 'zoom' to swap (stub)
#   JAAS_APP_ID          tenant id, looks like vpaas-magic-cookie-...
#   JAAS_KID             Key ID shown after uploading your public key,
#                        format "<JAAS_APP_ID>/<shortId>" e.g. vpaas-...-cookie-xxx/abc123
#   JAAS_PRIVATE_KEY     the RSA PRIVATE key PEM whose public half you uploaded;
#                        use literal \n for newlines when stored as one line
VIDEO_PROVIDER=
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=
# Per-endpoint signing secret for the JaaS recording webhook (console →
# Webhooks → your endpoint → Reveal secret). Verifies X-Jaas-Signature on
# /api/webhooks/recording so recordings are offloaded to Supabase before the
# 24h JaaS link expires.
JAAS_WEBHOOK_SECRET=
# Optional shared secret for the legacy manual recording-offload path (testing).
RECORDING_WEBHOOK_SECRET=

# Web store — Printful (print-on-demand). See docs/WEB-STORE-PLAN.md.
# PRINTFUL_API_KEY    store-level API token from the Printful dashboard
#                     (Settings → Stores → API). Leave blank to disable the store.
# PRINTFUL_STORE_ID   only needed when using an ACCOUNT-level token to scope
#                     requests to one store (sent as X-PF-Store-Id).
# PRINTFUL_WEBHOOK_SECRET  random secret embedded in the Printful webhook URL
#                     (?secret=…) and matched on receipt — Printful v1 webhooks
#                     are not HMAC-signed. Stripe is reused for payments.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=

# Background checks — Checkr (checkr.com). PRD §13. Stellr orders checks on behalf
# of adult non-students via the hosted-invite flow (Checkr emails the candidate to
# complete PII + FCRA consent on its own pages). Stellr is billed per report; the
# member is not charged. Provider is behind a seam (lib/background-provider) —
# leave the keys blank to disable ordering (the license-only path still works).
#   BACKGROUND_PROVIDER         provider id; defaults to 'checkr'
#   CHECKR_API_KEY              secret key (server-side); HTTP Basic, key as username
#   CHECKR_BASE_URL             https://api.checkr-staging.com/v1 (staging) |
#                               https://api.checkr.com/v1 (prod; email
#                               clients@checkr.com to enable live Reports)
#   CHECKR_PACKAGE_SLUG         criminal+identity package slug from YOUR dashboard
#   CHECKR_WORK_LOCATION_STATE  fallback 2-letter US state for work_locations —
#                               the jurisdiction whose FCRA/screening rules Checkr
#                               applies. This is the candidate's WORK/participation
#                               state, not company HQ. Overridden by the member's
#                               teacher-licensing state when present; used only as the
#                               fallback. e.g. UT.
#   CHECKR_WEBHOOK_SECRET       optional; defaults to CHECKR_API_KEY. Checkr signs
#                               with X-Checkr-Signature = HMAC-SHA256(rawBody, key),
#                               verified on /api/webhooks/background.
#   NEXT_PUBLIC_CHECKR_DASHBOARD_URL  base for the admin "view report in Checkr"
#                               link; https://dashboard.checkr-staging.com (staging)
#                               | https://dashboard.checkr.com (prod). Default prod.
BACKGROUND_PROVIDER=checkr
CHECKR_API_KEY=
CHECKR_BASE_URL=https://api.checkr-staging.com/v1
CHECKR_PACKAGE_SLUG=
CHECKR_WORK_LOCATION_STATE=
CHECKR_WEBHOOK_SECRET=
NEXT_PUBLIC_CHECKR_DASHBOARD_URL=https://dashboard.checkr-staging.com
