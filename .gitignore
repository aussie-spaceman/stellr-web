/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/

# clerk configuration (can include secrets)
/.clerk/

# AEO prompt-panel results (scripts/aeo-prompt-panel.ts) — local, uploaded to the tracker sheet
.aeo-panel/

# Vitest coverage output (deep review TEST-10: `vitest run --coverage`)
/coverage/
# Vitest 5 reporter and attachment output
/.vitest/
/lhci-report/

# The desk scanner's WebAssembly reader, copied from node_modules/zxing-wasm by
