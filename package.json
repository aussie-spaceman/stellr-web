{
  "name": "stellr-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:tokens": "node design/build-tokens.mjs",
    "lint": "eslint .",
    "lint:ci": "eslint app components packages lib proxy.ts --max-warnings 42",
    "lint:tokens": "node scripts/ds-lint.mjs",
    "lint:migrations": "node scripts/check-migration-names.mjs && node scripts/check-migration-security.mjs",
    "lint:pii": "node scripts/lint-pii.mjs",
    "migration:new": "supabase migration new",
    "db:status": "node scripts/db-status.mjs",
    "tracker": "node scripts/tracker.mjs",
    "worktrees": "node scripts/worktree-sweep.mjs",
    "check:deploy-ready": "node scripts/check-deploy-ready.mjs",
    "prebuild": "node design/build-tokens.mjs && node scripts/ds-lint.mjs && node scripts/check-migration-names.mjs && node scripts/check-migration-security.mjs && tsx scripts/check-watermarks.ts",
    "build": "next build",
    "start": "next start",
    "watermark:pdfs": "tsx scripts/watermark-pdfs.ts",
    "watermark:media": "tsx scripts/watermark-media.ts",
    "watermark:videos": "tsx scripts/watermark-videos.ts",
    "watermark:all": "tsx scripts/watermark-pdfs.ts && tsx scripts/watermark-media.ts && tsx scripts/watermark-videos.ts",
    "watermark:check": "tsx scripts/check-watermarks.ts",
    "watermark:worker": "tsx scripts/watermark-worker.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:welcome-drips": "tsx scripts/seed-welcome-drips.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "verify:prod": "tsx scripts/verify-prod-services.ts",
    "indexnow": "tsx scripts/indexnow-submit.ts",
    "aeo:crawlers": "tsx scripts/aeo-crawler-report.ts",
    "aeo:panel": "tsx scripts/aeo-prompt-panel.ts",
    "docusign:templates": "tsx scripts/docusign-templates.ts",
    "audit:event-prices": "tsx scripts/audit-event-prices.ts",
    "verify:apollo-hubspot": "tsx scripts/verify-apollo-hubspot.ts",
    "probe:apollo": "tsx scripts/probe-apollo-engagement.ts",
    "backfill:apollo": "tsx scripts/backfill-apollo-engagement.ts",
    "audit:event-slugs": "tsx scripts/audit-event-slugs.ts",
    "retention:medical-sql": "tsx scripts/medical-retention-sql.ts",
    "notify:event-waitlist": "tsx scripts/notify-event-waitlist.ts",
    "hubspot:sync-event-options": "tsx scripts/hubspot-sync-event-options.ts",
    "sync:event-spaces": "tsx scripts/sync-event-spaces.ts",
    "upload:event-flyers": "tsx scripts/upload-event-flyers.ts",
    "fix:event-slug": "tsx scripts/fix-event-slug.ts",
    "survey:definition": "tsx scripts/survey-definition.ts",
    "survey:seed-dev": "tsx scripts/survey-seed-dev.ts",
    "survey:retention": "tsx scripts/survey-retention.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "next build && E2E_PROD=1 playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "playwright test --config playwright.storybook.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.18",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/drive": "^27.0.0",
    "@googleapis/sheets": "^18.1.1",
    "@hookform/resolvers": "^5.9.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "next-sanity": "^13.3.4",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sanity": "^6.20.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "styled-components": "^6.6.0",
    "svix": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.48",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.2.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "storybook": "^10.6.3",
    "style-dictionary": "^5.7.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "//dependencyNotes": {
    "styled-components": "No direct imports — it is a required peer of sanity@6 (node_modules/sanity peerDependencies). Keep it in dependencies; do not 'clean it up' as unused. (deep review QUAL-11)",
    "@vercel/blob": "devDependency: imported only by scripts/upload-media.ts; the runtime reads Blob URLs over plain HTTP, not via this SDK. (deep review QUAL-11)",
    "overrides (Sanity CLI)": "Patched copies of deps that @sanity/cli's own dependencies pin to vulnerable versions: @vercel/frameworks pins js-yaml 3.13.1 and smol-toml 1.5.2, @module-federation/dts-plugin pins undici 7.29.1, typeid-js wants uuid ^10. Each override stays in the same major except uuid 10 -> 11, the version the rest of the Sanity tree already uses. CLI tooling only, not Studio or site runtime. Drop an entry once Sanity ships the fix.",
    "overrides (@vercel/cli-config)": "Pulled in by @vercel/blob (dev) and pins zod 4.1.11, below the 4.6.6 fix. Same major. Drop once @vercel/blob updates it.",
    "overrides (eslint-plugin-jsx-a11y)": "6.10.2 still declares peer eslint ^3–^9 (upstream issue #1075), but at runtime it only uses context.options/report/settings, which ESLint 10 keeps. The override lets it see our eslint 10. Drop once the plugin widens its peer range."
  },
  "overrides": {
    "tar": "^7.5.22",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "^7.30.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
